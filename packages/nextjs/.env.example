# Copy to .env.local and fill in (see SETUP-KEYS.md). All gitignored.

# Chain: 31337 = local anvil (M3), 84532 = Base Sepolia (M4)
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org

# Deployed DriveRegistry (filled after M4 deploy)
NEXT_PUBLIC_DRIVE_REGISTRY_ADDRESS=

# Pinata (M4) — JWT is server-side only, no NEXT_PUBLIC_ prefix
NEXT_PUBLIC_PINATA_GATEWAY=
PINATA_JWT=

# Privy (M4)
NEXT_PUBLIC_PRIVY_APP_ID=

# The Graph (M4)
NEXT_PUBLIC_SUBGRAPH_URL=
